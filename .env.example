# Configuration reference; scripts/podman-up.sh generates a local .env on first run.
# Replace all placeholder credentials before using this file as your configuration.
DATABASE_URL=postgresql+psycopg://calculus:change-me@127.0.0.1:15433/calculus
POSTGRES_USER=calculus
POSTGRES_DB=calculus
POSTGRES_PASSWORD=change-me
SECRET_KEY=replace-with-a-random-string-of-at-least-32-characters
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
STORAGE_DIR=/data
TASK_MODE=celery
REDIS_URL=redis://127.0.0.1:16380/0
SEMANTICA_ENABLED=true
ALLOW_DEMO_PROVIDER=false
# Default Ollama discovery address. Generation and embedding profiles are managed
# in the admin interface and selected independently in each application's draft.
EMBEDDING_BASE_URL=http://127.0.0.1:11434
MODEL_TIMEOUT=90
# Chat execution only (/chat and /chat/stream). Shared database leases coordinate
# all API workers; these settings do not automatically throttle imports/evaluation.
# One model profile ID has its own capacity, including chat generation/embedding
# and agent/subagent requests. Separate profiles have separate capacities.
MODEL_CONCURRENCY=4
MODEL_QUEUE_CAPACITY=24
MODEL_QUEUE_TIMEOUT=30
# A user's active chats and queue are shared across their applications.
USER_CHAT_CONCURRENCY=2
USER_CHAT_QUEUE_CAPACITY=4
USER_CHAT_QUEUE_TIMEOUT=30
# Seconds: lease renewal recovers abandoned capacity after process failure.
# Apply database migrations with alembic upgrade head before starting new services.
ADMISSION_LEASE_SECONDS=30
ADMISSION_POLL_SECONDS=0.2
COOKIE_SECURE=false
# PDF/images are sent to this explicitly configured cloud OCR service.
# With OCR_ENABLED=false, import TXT/Markdown/DOCX/PPTX text locally instead.
# PDF and image imports currently require the configured OCR service.
OCR_ENABLED=true
PADDLEOCR_TOKEN=
PADDLEOCR_MODEL=PaddleOCR-VL-1.6
PADDLEOCR_JOB_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
OCR_TIMEOUT=3600
